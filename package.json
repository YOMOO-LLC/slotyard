{
  "name": "slotyard",
  "version": "0.3.0",
  "description": "Tells the truth about local parallel dev environments: nothing silently shares a database, and stacks start/stop on demand",
  "type": "module",
  "bin": {
    "slotyard": "src/cli.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "files": [
    "src",
    "README.md",
    "DECISIONS.md",
    "LICENSE"
  ],
  "scripts": {
    "desktop": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOMOO-LLC/slotyard.git"
  },
  "homepage": "https://github.com/YOMOO-LLC/slotyard#readme",
  "bugs": {
    "url": "https://github.com/YOMOO-LLC/slotyard/issues"
  },
  "keywords": [
    "supabase",
    "docker",
    "git-worktree",
    "local-development",
    "ports"
  ],
  "author": "YOMOO LLC",
  "license": "MIT"
}
